<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence https://jakarta.ee/xml/ns/persistence/persistence_3_2.xsd"
             version="3.2">
    <persistence-unit name="default" transaction-type="JTA">
        <jta-data-source>java:/jdbc/APUHRMSDS</jta-data-source>

        <class>com.apu.hrms.entity.User</class>
        <class>com.apu.hrms.entity.Room</class>
        <class>com.apu.hrms.entity.BookingOrder</class>
        <class>com.apu.hrms.entity.BookingRoom</class>
        <class>com.apu.hrms.entity.Payment</class>
        <class>com.apu.hrms.entity.CleaningTask</class>
        <class>com.apu.hrms.entity.Feedback</class>
        <class>com.apu.hrms.entity.Comment</class>
        <class>com.apu.hrms.entity.CommentMention</class>
        <class>com.apu.hrms.entity.PasswordResetToken</class>

        <properties>
            <property name="hibernate.hbm2ddl.auto"
                      value="update"/>
            <property name="hibernate.show_sql"
                      value="true"/>
            <property name="hibernate.format_sql"
                      value="true"/>
        </properties>
    </persistence-unit>
</persistence>
